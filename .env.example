# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# LLM API key for the schema-bound document extractor (PLAN.md step 1).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Set only in production. When unset, the app uses local SQLite and local
# disk storage — no external credentials needed for local dev or tests.
# DATABASE_URL is auto-injected by Vercel once Neon Postgres is connected
# via the Marketplace — use the pooled ("-pooler") connection string.
# BLOB_READ_WRITE_TOKEN is auto-injected once a Vercel Blob store is created.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname
# BLOB_READ_WRITE_TOKEN=

# Optional overrides — defaults are in app/config.py.
# GEMINI_MODEL=gemini-3.8-flash
# STATUTES_PATH=./statutes.yaml
# UPLOADS_DIR=./uploads
